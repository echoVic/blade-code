{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "packages/cli": {
      "entry": ["src/blade.tsx", "src/acp/index.ts", "scripts/*.{js,ts}"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/cli/web": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/vscode": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreExportsUsedInFile": true,
  "rules": {
    "enumMembers": "off"
  }
}
